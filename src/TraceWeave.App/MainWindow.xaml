<Window x:Class="TraceWeave.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TraceWeave" Height="900" Width="1480" MinHeight="760" MinWidth="1180"
        Background="{StaticResource PageBackground}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="18,24">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,30">
                        <Border Width="38" Height="38" CornerRadius="11" Background="#4568E8">
                            <TextBlock Text="T" Foreground="White" FontSize="23" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TraceWeave" Foreground="White" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="操作记忆 · AI 工作流" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="工作空间" Foreground="#74819A" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,8" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="0" Click="Navigate_Click" Content="⌂   总览" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="1" Click="Navigate_Click" Content="◉   操作录制" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="2" Click="Navigate_Click" Content="▤   工作流程" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="3" Click="Navigate_Click" Content="✧   AI 校正中心" />
                    <TextBlock Text="系统" Foreground="#74819A" FontSize="11" FontWeight="SemiBold" Margin="10,24,0,8" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="4" Click="Navigate_Click" Content="⚙   设置与隐私" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#1B2940" CornerRadius="12" Padding="13">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#31C48D" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="  采集未启动" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="原始记录默认仅保存在本机。录制、剪贴板文本、远程 AI 分别控制。"
                                   Foreground="#94A3B8" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="34,26,34,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="62" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="TraceWeave 工作台" Foreground="{StaticResource TextPrimary}" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="记录一次真实操作 → 首次自动清理 → 人工 / AI 二次校正 → 导出技能"
                               Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#E8F7F0" CornerRadius="20" Padding="12,7" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderStatus" Text="● 本地优先" Foreground="#16794F" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </DockPanel>

            <TabControl x:Name="MainTabs" Grid.Row="1" SelectedIndex="0" Background="Transparent" BorderThickness="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </TabControl.Template>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="把真实操作变成 AI 可以复用的工作流" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="TraceWeave 不把录屏直接转成点击脚本，而是同时观察鼠标、快捷键、剪贴板、窗口和 UI Automation，并在第一次生成时主动去掉明显的人工噪声。"
                                       FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,9,0,24" TextWrapping="Wrap" />

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="原始事件" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                        <TextBlock x:Name="DashboardEventCount" Text="0" Foreground="{StaticResource TextPrimary}" FontSize="30" FontWeight="Bold" Margin="0,6,0,2" />
                                        <TextBlock Text="当前录制的不可变证据" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="4,0">
                                    <StackPanel>
                                        <TextBlock Text="当前步骤" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                        <TextBlock x:Name="DashboardStepCount" Text="0" Foreground="{StaticResource TextPrimary}" FontSize="30" FontWeight="Bold" Margin="0,6,0,2" />
                                        <TextBlock Text="首次优化后的 Draft" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="版本" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                        <TextBlock x:Name="DashboardVersion" Text="—" Foreground="{StaticResource TextPrimary}" FontSize="30" FontWeight="Bold" Margin="0,6,0,2" />
                                        <TextBlock Text="每次人工 / AI 修改都是新版本" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,9,0">
                                    <StackPanel>
                                        <TextBlock Text="四段式工作流" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="从事实记录到可执行技能，始终保留证据链。" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,16" />
                                        <TextBlock Text="01  多源采集" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="鼠标 · 快捷键 · 已提交文本 · 剪贴板 · 窗口 · UIA" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,12" />
                                        <TextBlock Text="02  首次自动优化" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="去噪 · 去重 · 数据关联 · 参数化 · 删除无效等待" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,12" />
                                        <TextBlock Text="03  二次校正" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="人工直接编辑，或让高级模型给出带证据的修改提案" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,12" />
                                        <TextBlock Text="04  验证与导出" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="版本化保存 → 选择性应用 → workflow.json + SKILL.md" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="9,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="快速开始" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="第一次使用建议先录一个 20～60 秒的小任务。" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,16" TextWrapping="Wrap" />
                                        <Button Content="开始第一次录制 →" Click="StartFromDashboard_Click" Padding="14,10" HorizontalAlignment="Left" />
                                        <TextBlock Text="提示：录制期间窗口会显示明确状态；密码框、安全窗口和排除进程不会进入原始记录。"
                                                   Foreground="{StaticResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="操作录制" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="建议给任务写一句意图。它会作为首次生成和后续 AI 审查的上下文，而不是作为事实覆盖原始证据。"
                                               FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,10" />
                                    <TextBox x:Name="IntentBox" Height="34" Padding="10,7" BorderBrush="#D8DEE9"
                                             Text="完成我正在演示的这个任务" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="18,0,0,0">
                                    <Button x:Name="StartButton" Content="● 开始录制" Click="Start_Click" Padding="15,9" Margin="0,0,7,0" />
                                    <Button x:Name="PauseButton" Content="Ⅱ 暂停" Click="Pause_Click" Padding="15,9" Margin="0,0,7,0" IsEnabled="False" />
                                    <Button x:Name="ResumeButton" Content="▶ 继续" Click="Resume_Click" Padding="15,9" Margin="0,0,7,0" IsEnabled="False" />
                                    <Button x:Name="StopButton" Content="■ 停止并生成" Click="Stop_Click" Padding="15,9" IsEnabled="False" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="采集范围" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                        <WrapPanel Margin="0,10,0,10">
                                            <CheckBox x:Name="MouseCheck" IsChecked="True" Content="鼠标" Margin="0,0,14,0" />
                                            <CheckBox x:Name="ShortcutCheck" IsChecked="True" Content="快捷键" Margin="0,0,14,0" />
                                            <CheckBox x:Name="ClipboardMetaCheck" IsChecked="True" Content="剪贴板事件" Margin="0,0,14,0" />
                                            <CheckBox x:Name="ClipboardTextCheck" IsChecked="False" Content="剪贴板文本" Margin="0,0,14,0" />
                                            <CheckBox x:Name="UiAutomationCheck" IsChecked="True" Content="UI Automation" Margin="0,0,14,0" />
                                            <CheckBox x:Name="CommittedTextCheck" IsChecked="True" Content="已提交文本" />
                                        </WrapPanel>
                                        <TextBlock x:Name="CaptureHint" Text="未开始。剪贴板文本默认关闭；开启后仍会先本地脱敏。"
                                                   Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,0,0,12" />
                                    </StackPanel>
                                    <ListBox x:Name="TimelineList" BorderThickness="0" Background="#F8FAFC"
                                             FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="7,5" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="本次录制" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock x:Name="RecordingIdText" Text="尚未开始" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="0,6,0,16" TextWrapping="Wrap" />
                                    <TextBlock Text="事件数量" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                    <TextBlock x:Name="RecordingCountText" Text="0" Foreground="{StaticResource TextPrimary}" FontSize="30" FontWeight="Bold" />
                                    <TextBlock Text="持久化错误" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,14,0,0" />
                                    <TextBlock x:Name="PersistenceText" Text="无" Foreground="#16865B" FontSize="11" TextWrapping="Wrap" />
                                    <Border Background="#FFF7E8" CornerRadius="9" Padding="10" Margin="0,18,0,0">
                                        <TextBlock Text="注意：TraceWeave 不是传统键盘记录器。普通字符键不逐键保存，文本优先通过 UI Automation 的 Value/Text 变化和输入法提交后的控件状态捕获。"
                                                   Foreground="#8A5B13" FontSize="10" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="工作流程" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock x:Name="WorkflowSummaryText" Text="完成一次录制后，这里会出现 Draft v1。" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="↑ 上移" Click="MoveUp_Click" Padding="12,8" Margin="0,0,6,0" />
                                <Button Content="↓ 下移" Click="MoveDown_Click" Padding="12,8" Margin="0,0,6,0" />
                                <Button Content="删除步骤" Click="DeleteStep_Click" Padding="12,8" Margin="0,0,6,0" />
                                <Button Content="导出" Click="Export_Click" Padding="12,8" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                                <ListBox x:Name="StepList" SelectionChanged="StepList_SelectionChanged" BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E7EBF2" BorderThickness="0,0,0,1" Padding="6,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="38" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Order}" FontSize="17" FontWeight="Bold" Foreground="#4568E8" VerticalAlignment="Top" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                                        <TextBlock Text="{Binding Action}" FontSize="10" Foreground="#4568E8" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding Intent}" FontSize="10" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8,0,0,0">
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="步骤编辑" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            <TextBlock Text="保存后会产生新的 HumanEdit revision，不覆盖历史版本。" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,12" />
                                            <TextBlock Text="标题" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                            <TextBox x:Name="StepTitleBox" Margin="0,4,0,9" />
                                            <TextBlock Text="意图" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                            <TextBox x:Name="StepIntentBox" Margin="0,4,0,9" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="54" />
                                            <TextBlock Text="输入模板" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                            <TextBox x:Name="StepInputBox" Margin="0,4,0,9" />
                                            <TextBlock Text="快捷键" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                            <TextBox x:Name="StepShortcutBox" Margin="0,4,0,10" />
                                            <Button Content="保存当前步骤" Click="SaveStep_Click" Padding="12,8" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Text="版本历史" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                            <ListBox x:Name="RevisionList" Height="190" Margin="0,9,0,9" BorderThickness="0"
                                                     SelectionChanged="RevisionList_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="2,4">
                                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextPrimary}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Button Content="恢复选中的历史版本" Click="RestoreRevision_Click" Padding="12,8" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="AI 校正中心" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="第一次优化已经自动发生；这里是独立的第二次审查。默认先使用本地规则审查，配置后可切换 OpenAI-compatible 高级模型。"
                                       FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,14" TextWrapping="Wrap" />

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <WrapPanel>
                                        <RadioButton x:Name="LocalReviewRadio" Content="本地审查（离线）" IsChecked="True" GroupName="ReviewMode" Margin="0,0,18,0" />
                                        <RadioButton x:Name="RemoteReviewRadio" Content="高级模型（OpenAI-compatible）" GroupName="ReviewMode" />
                                    </WrapPanel>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="AiEndpointBox" Grid.Column="0" Margin="0,0,6,0" ToolTip="例如 https://api.example.com/v1" />
                                        <TextBox x:Name="AiModelBox" Grid.Column="1" Margin="6,0" ToolTip="模型名" />
                                        <PasswordBox x:Name="AiKeyBox" Grid.Column="2" Margin="6,0,0,0" ToolTip="API Key" />
                                    </Grid>
                                    <TextBox x:Name="ReviewInstructionBox" Margin="0,10,0,0" Height="52"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             ToolTip="可选：告诉高级模型重点检查什么，例如“重点找出多余点击和错误等待”。" />
                                    <Button Content="开始二次审查" Click="Review_Click" Padding="14,8" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="1.05*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="发现的问题" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock x:Name="ReviewSummaryText" Text="尚未运行审查。" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,9" TextWrapping="Wrap" />
                                        <ListBox x:Name="FindingList" BorderThickness="0" Background="Transparent">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="9" Margin="0,0,0,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextPrimary}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="AI 修改提案" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="只应用你勾选的提案；应用后产生新的 AiReview revision。" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,9" />
                                        <ListBox x:Name="ProposalList" BorderThickness="0" Background="Transparent">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding}" IsChecked="True" Margin="0,0,0,7" Padding="4" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button Content="应用勾选提案" Click="ApplyProposals_Click" Padding="14,8" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="设置与隐私" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="默认本地优先。这里的设置只影响未来录制，不会偷偷修改已经保存的原始证据。"
                                       FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,14" />

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="敏感应用排除" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="除内置密码管理器和凭据相关窗口外，可追加进程名。用逗号或换行分隔。"
                                               FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,9" />
                                    <TextBox x:Name="ExcludedProcessesBox" Height="76" AcceptsReturn="True" TextWrapping="Wrap"
                                             Text="KeePass.exe, KeePassXC.exe, 1Password.exe, Bitwarden.exe" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="隐私原则" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="• 密码控件：永不读取 Value/Text 内容。&#10;• 敏感窗口：事件直接丢弃，不进入 journal。&#10;• 普通键盘：不逐键保存字符。&#10;• 剪贴板：事件默认记录，文本内容需要单独打开。&#10;• 文本脱敏：API key、Bearer、私钥、password= 等候选值在本地先阻断。&#10;• AI：默认不发送原始事件；远程二次审查只拿当前工作流。"
                                               Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
